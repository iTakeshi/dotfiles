#!/usr/bin/env bash
# yadm pre_commit hook — block commits that introduce unknown secrets.
#
# Scans staged files with Yelp/detect-secrets, ignoring findings already
# recorded in the baseline. A non-zero exit aborts `yadm commit` (see man yadm,
# HOOKS). lazy-lock.json は中身が git コミットSHA(40桁hex)で誤検知のため除外。
#
# Tracked by yadm; works on any machine after `yadm clone` (needs `uvx`).
set -euo pipefail

baseline="$YADM_HOOK_WORK/.config/yadm/secrets.baseline"
exclude='lazy-lock\.json'

# Staged files (Added/Copied/Modified), NUL-safe, paths relative to work-tree.
mapfile -d '' -t files < <(
	git --git-dir="$YADM_HOOK_REPO" --work-tree="$YADM_HOOK_WORK" \
		diff --cached --name-only --diff-filter=ACM -z
)

[ ${#files[@]} -eq 0 ] && { echo "detect-secrets: no staged files — skip" >&2; exit 0; }

cd "$YADM_HOOK_WORK"
if uvx --from detect-secrets detect-secrets-hook \
	--baseline "$baseline" \
	--exclude-files "$exclude" \
	-- "${files[@]}"; then
	echo "detect-secrets: ${#files[@]} staged file(s) scanned — no new secrets ✓" >&2
else
	exit 1  # detect-secrets-hook already printed its ERROR report above
fi
