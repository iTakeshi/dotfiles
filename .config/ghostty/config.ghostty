# Appearance
theme = Sonokai
cursor-color = green

# Font
font-family = FantasqueSansM Nerd Font Mono
font-size = 13
font-feature = -calt
font-feature = -clig
font-feature = -liga

# Window
window-padding-x = 3
window-padding-y = 3

# Tab management
keybind = ctrl+t=new_tab
# unbind Ghostty's default ctrl+shift+t (new_tab) so it passes through to the
# app; Neovim uses <C-S-t> for toggleterm. New tab stays on ctrl+t above.
keybind = ctrl+shift+t=unbind

# Switch to tab by number
keybind = ctrl+1=goto_tab:1
keybind = ctrl+2=goto_tab:2
keybind = ctrl+3=goto_tab:3
keybind = ctrl+4=goto_tab:4
keybind = ctrl+5=goto_tab:5
keybind = ctrl+6=goto_tab:6
keybind = ctrl+7=goto_tab:7
keybind = ctrl+8=goto_tab:8
keybind = ctrl+9=goto_tab:9

# Move tab to position
keybind = ctrl+alt+1=move_tab:0
keybind = ctrl+alt+2=move_tab:1
keybind = ctrl+alt+3=move_tab:2
keybind = ctrl+alt+4=move_tab:3
keybind = ctrl+alt+5=move_tab:4
keybind = ctrl+alt+6=move_tab:5
keybind = ctrl+alt+7=move_tab:6
keybind = ctrl+alt+8=move_tab:7

# Font size control
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+equal=increase_font_size:1
keybind = ctrl+0=reset_font_size

# Pane split
keybind = ctrl+shift+alt+b=new_split:down
keybind = ctrl+shift+alt+v=new_split:right

# Pane resize
keybind = ctrl+shift+alt+h=resize_split:left,5
keybind = ctrl+shift+alt+l=resize_split:right,5
keybind = ctrl+shift+alt+k=resize_split:up,5
keybind = ctrl+shift+alt+j=resize_split:down,5

# Pane navigation
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down

# Toggle pane zoom
keybind = ctrl+shift+z=toggle_split_zoom
